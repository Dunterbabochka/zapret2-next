# Classic reference: local Windows bundle 1.10.3.
[PRESET_INIT]
--lua-init=@../lua/zapret-next.lua
[TCP_HTTP]
--payload=empty
--lua-desync=syndata
--payload=http_req
--lua-desync=multidisorder_legacy:pos=2:tcp_ts_up
[TCP_TLS]
--payload=empty
--lua-desync=syndata
--payload=tls_client_hello
--lua-desync=multidisorder_legacy:pos=2:tcp_ts_up
[DISCORD_MEDIA_TLS]
--payload=empty
--lua-desync=syndata
--payload=tls_client_hello
--lua-desync=multidisorder_legacy:pos=2:tcp_ts_up
[GOOGLE_TLS]
--payload=empty
--lua-desync=syndata
--payload=tls_client_hello
--lua-desync=multidisorder_legacy:pos=2:tcp_ts_up
[TCP_GENERIC]
--payload=http_req
--payload=empty
--lua-desync=syndata
--payload=http_req
--lua-desync=multidisorder_legacy:pos=2:tcp_ts_up
--payload=tls_client_hello
--payload=tls_client_hello
--lua-desync=multidisorder_legacy:pos=2:tcp_ts_up
[QUIC]
--lua-desync=fake:blob=quic_google:repeats=6
[IPSET_TCP_PORTS]
2053
2083
2087
2096
8443
[VOICE_COMPATIBLE]
--filter-udp=19294-19344,50000-50100
--filter-l7=discord,stun
--payload=discord_ip_discovery
--lua-desync=fake:blob=discord_voice:repeats=6
--payload=stun
--lua-desync=fake:blob=discord_voice:repeats=6
[GAME_TCP_RANGE]
<n4
[GAME_TCP_ACTIONS]
--payload=http_req
--payload=empty
--lua-desync=syndata
--payload=http_req
--lua-desync=multidisorder_legacy:pos=2:tcp_ts_up
--payload=tls_client_hello
--payload=tls_client_hello
--lua-desync=multidisorder_legacy:pos=2:tcp_ts_up
--payload=unknown
--payload=unknown
--lua-desync=multidisorder_legacy:pos=2:tcp_ts_up
[GAME_UDP_RANGE]
<n3
[GAME_UDP_ACTIONS]
--lua-desync=fake:blob=game_udp:repeats=14:payload=all
[CLASSIC_TCP_PROFILE]
--filter-l3=ipv4
--filter-tcp=80,443,2053,2083,2087,2096,8443
--hostlist-exclude=../lists/list-exclude.txt
--hostlist-exclude=../lists/list-exclude-user.txt
--ipset-exclude=../lists/ipset-exclude.txt
--ipset-exclude=../lists/ipset-exclude-user.txt
--payload=empty
--lua-desync=syndata
--payload=http_req,tls_client_hello,unknown
--lua-desync=multidisorder_legacy:pos=2
