# Classic reference: local Windows bundle 1.10.3; see docs/CLASSIC.md.
[PRESET_INIT]
--lua-init=@../lua/zapret-next.lua
--blob=stun2:@fake/stun2.bin
[TCP_HTTP]
--lua-desync=fake:blob=tls_max:repeats=6:tcp_seq=2:tcp_ack=-66000:tcp_ts_up
[TCP_TLS]
--lua-desync=fake:blob=stun2:repeats=6:tcp_seq=2:tcp_ack=-66000:tcp_ts_up
--lua-desync=fake:blob=tls_google:repeats=6:tcp_seq=2:tcp_ack=-66000:tcp_ts_up
[DISCORD_MEDIA_TLS]
--lua-desync=fake:blob=tls_google:repeats=6:tcp_seq=2:tcp_ack=-66000:tcp_ts_up
[GOOGLE_TLS]
--lua-desync=fake:blob=tls_google:repeats=6:tcp_seq=2:tcp_ack=-66000:ip_id=zero:tcp_ts_up
[TCP_GENERIC]
--payload=http_req
--lua-desync=fake:blob=tls_max:repeats=6:tcp_seq=2:tcp_ack=-66000:tcp_ts_up
--payload=tls_client_hello
--lua-desync=fake:blob=stun2:repeats=6:tcp_seq=2:tcp_ack=-66000:tcp_ts_up
--lua-desync=fake:blob=tls_google:repeats=6:tcp_seq=2:tcp_ack=-66000:tcp_ts_up
[QUIC]
--lua-desync=fake:blob=quic_google:repeats=6
[IPSET_TCP_PORTS]
8443
[VOICE_COMPATIBLE]
--filter-udp=19294-19344,50000-50100
--filter-l7=discord,stun
--payload=discord_ip_discovery
--lua-desync=fake:blob=discord_voice:repeats=6
--payload=stun
--lua-desync=fake:blob=discord_voice:repeats=6
[GAME_TCP_RANGE]
<n3
[GAME_TCP_ACTIONS]
--payload=http_req
--lua-desync=fake:blob=tls_max:repeats=6:tcp_seq=2:tcp_ack=-66000:tcp_ts_up
--payload=tls_client_hello
--lua-desync=fake:blob=stun2:repeats=6:tcp_seq=2:tcp_ack=-66000:tcp_ts_up
--lua-desync=fake:blob=tls_google:repeats=6:tcp_seq=2:tcp_ack=-66000:tcp_ts_up
--payload=unknown
--lua-desync=fake:blob=stun2:repeats=6:tcp_seq=2:tcp_ack=-66000:tcp_ts_up:payload=unknown
--lua-desync=fake:blob=tls_google:repeats=6:tcp_seq=2:tcp_ack=-66000:tcp_ts_up:payload=unknown
[GAME_UDP_RANGE]
<n2
[GAME_UDP_ACTIONS]
--lua-desync=fake:blob=game_udp:repeats=10:payload=all
