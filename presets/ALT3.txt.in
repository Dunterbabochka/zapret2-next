# Classic reference: local Windows bundle 1.10.3.
[PRESET_INIT]
--lua-init=@../lua/zapret-next.lua
[TCP_HTTP]
--lua-desync=fake:blob=tls_max:repeats=1:tcp_ts=-600000:tcp_ts_up
--lua-desync=next_hostfakesplit:host=ya.ru:tcp_ts=-600000:tcp_ts_up:repeats=1
[TCP_TLS]
--lua-desync=fake:blob=fake_default_tls:repeats=1:tcp_ts=-600000:tcp_ts_up:tls_mod=rnd,dupsid,sni=ya.ru
--lua-desync=next_hostfakesplit:host=ya.ru:tcp_ts=-600000:tcp_ts_up:repeats=1
[DISCORD_MEDIA_TLS]
--lua-desync=fake:blob=fake_default_tls:repeats=1:tcp_ts=-600000:tcp_ts_up:tls_mod=rnd,dupsid,sni=www.google.com
--lua-desync=next_hostfakesplit:host=www.google.com:tcp_ts=-600000:tcp_ts_up:repeats=1
[GOOGLE_TLS]
--lua-desync=fake:blob=fake_default_tls:repeats=1:tcp_ts=-600000:ip_id=zero:tcp_ts_up:tls_mod=rnd,dupsid,sni=www.google.com
--lua-desync=next_hostfakesplit:host=www.google.com:tcp_ts=-600000:ip_id=zero:tcp_ts_up:repeats=1
[TCP_GENERIC]
--payload=http_req
--lua-desync=fake:blob=tls_max:repeats=1:tcp_ts=-600000:tcp_ts_up
--lua-desync=next_hostfakesplit:host=ya.ru:tcp_ts=-600000:tcp_ts_up:repeats=1
--payload=tls_client_hello
--lua-desync=fake:blob=fake_default_tls:repeats=1:tcp_ts=-600000:tcp_ts_up:tls_mod=rnd,dupsid,sni=ya.ru
--lua-desync=next_hostfakesplit:host=ya.ru:tcp_ts=-600000:tcp_ts_up:repeats=1
[QUIC]
--lua-desync=fake:blob=quic_google:repeats=6
[IPSET_TCP_PORTS]
8443
[VOICE_COMPATIBLE]
--filter-udp=19294-19344,50000-50100
--filter-l7=discord,stun
--payload=discord_ip_discovery
--lua-desync=fake:blob=discord_voice:repeats=6
--payload=stun
--lua-desync=fake:blob=discord_voice:repeats=6
[GAME_TCP_RANGE]
<n4
[GAME_TCP_ACTIONS]
--payload=http_req
--lua-desync=fake:blob=tls_max:repeats=1:tcp_ts=-600000:tcp_ts_up
--lua-desync=next_hostfakesplit:host=ya.ru:tcp_ts=-600000:tcp_ts_up:repeats=1
--payload=tls_client_hello
--lua-desync=fake:blob=fake_default_tls:repeats=1:tcp_ts=-600000:tcp_ts_up:tls_mod=rnd,dupsid,sni=ya.ru
--lua-desync=next_hostfakesplit:host=ya.ru:tcp_ts=-600000:tcp_ts_up:repeats=1
--payload=unknown
--lua-desync=fake:blob=tls_max:repeats=1:tcp_ts=-600000:tcp_ts_up:payload=unknown
--lua-desync=next_hostfakesplit:host=ya.ru:tcp_ts=-600000:tcp_ts_up:repeats=1
[GAME_UDP_RANGE]
<n4
[GAME_UDP_ACTIONS]
--lua-desync=fake:blob=game_udp:repeats=10:payload=all
