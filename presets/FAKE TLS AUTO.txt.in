# Classic reference: local Windows bundle 1.10.3.
[PRESET_INIT]
--lua-init=@../lua/zapret-next.lua
[TCP_HTTP]
--lua-desync=fake:blob=tls_max:repeats=11:tcp_seq=-10000:tcp_ack=-66000:tcp_ts_up
--lua-desync=multidisorder_legacy:pos=1,midsld:tcp_ts_up
[TCP_TLS]
--lua-desync=fake:blob=0x00000000:repeats=11:tcp_seq=-10000:tcp_ack=-66000:tcp_ts_up:tls_mod=rnd,dupsid,sni=www.google.com
--lua-desync=tls_client_hello_clone:blob=classic_clone:fallback=tls_google
--lua-desync=fake:blob=classic_clone:repeats=11:tcp_seq=-10000:tcp_ack=-66000:tcp_ts_up:tls_mod=rnd,dupsid,sni=www.google.com
--lua-desync=multidisorder_legacy:pos=1,midsld:tcp_ts_up
[DISCORD_MEDIA_TLS]
--lua-desync=fake:blob=0x00000000:repeats=11:tcp_seq=-10000:tcp_ack=-66000:tcp_ts_up:tls_mod=rnd,dupsid,sni=www.google.com
--lua-desync=tls_client_hello_clone:blob=classic_clone:fallback=tls_google
--lua-desync=fake:blob=classic_clone:repeats=11:tcp_seq=-10000:tcp_ack=-66000:tcp_ts_up:tls_mod=rnd,dupsid,sni=www.google.com
--lua-desync=multidisorder_legacy:pos=1,midsld:tcp_ts_up
[GOOGLE_TLS]
--lua-desync=fake:blob=0x00000000:repeats=11:tcp_seq=-10000:tcp_ack=-66000:ip_id=zero:tcp_ts_up:tls_mod=rnd,dupsid,sni=www.google.com
--lua-desync=tls_client_hello_clone:blob=classic_clone:fallback=tls_google
--lua-desync=fake:blob=classic_clone:repeats=11:tcp_seq=-10000:tcp_ack=-66000:ip_id=zero:tcp_ts_up:tls_mod=rnd,dupsid,sni=www.google.com
--lua-desync=multidisorder_legacy:pos=1,midsld:ip_id=zero:tcp_ts_up
[TCP_GENERIC]
--payload=http_req
--lua-desync=fake:blob=tls_max:repeats=11:tcp_seq=-10000:tcp_ack=-66000:tcp_ts_up
--lua-desync=multidisorder_legacy:pos=1,midsld:tcp_ts_up
--payload=tls_client_hello
--lua-desync=fake:blob=0x00000000:repeats=11:tcp_seq=-10000:tcp_ack=-66000:tcp_ts_up:tls_mod=rnd,dupsid,sni=www.google.com
--lua-desync=tls_client_hello_clone:blob=classic_clone:fallback=tls_google
--lua-desync=fake:blob=classic_clone:repeats=11:tcp_seq=-10000:tcp_ack=-66000:tcp_ts_up:tls_mod=rnd,dupsid,sni=www.google.com
--lua-desync=multidisorder_legacy:pos=1,midsld:tcp_ts_up
[QUIC]
--lua-desync=fake:blob=quic_google:repeats=11
[IPSET_TCP_PORTS]
8443
[VOICE_COMPATIBLE]
--filter-udp=19294-19344,50000-50100
--filter-l7=discord,stun
--payload=discord_ip_discovery
--lua-desync=fake:blob=discord_voice:repeats=6
--payload=stun
--lua-desync=fake:blob=discord_voice:repeats=6
[GAME_TCP_RANGE]
<n4
[GAME_TCP_ACTIONS]
--payload=http_req
--lua-desync=fake:blob=tls_max:repeats=11:tcp_seq=-10000:tcp_ack=-66000:tcp_ts_up
--lua-desync=multidisorder_legacy:pos=1,midsld:tcp_ts_up
--payload=tls_client_hello
--lua-desync=fake:blob=0x00000000:repeats=11:tcp_seq=-10000:tcp_ack=-66000:tcp_ts_up:tls_mod=rnd,dupsid,sni=www.google.com
--lua-desync=tls_client_hello_clone:blob=classic_clone:fallback=tls_google
--lua-desync=fake:blob=classic_clone:repeats=11:tcp_seq=-10000:tcp_ack=-66000:tcp_ts_up:tls_mod=rnd,dupsid,sni=www.google.com
--lua-desync=multidisorder_legacy:pos=1,midsld:tcp_ts_up
--payload=unknown
--lua-desync=fake:blob=0x00000000:repeats=11:tcp_seq=-10000:tcp_ack=-66000:tcp_ts_up:payload=unknown
--lua-desync=fake:blob=tls_max:repeats=11:tcp_seq=-10000:tcp_ack=-66000:tcp_ts_up:payload=unknown
--lua-desync=multidisorder_legacy:pos=1,midsld:tcp_ts_up
[GAME_UDP_RANGE]
<n2
[GAME_UDP_ACTIONS]
--lua-desync=fake:blob=game_udp:repeats=10:payload=all
