# Classic reference: local Windows bundle 1.10.4.
[PRESET_INIT]
--lua-init=@../lua/zapret-next.lua
--blob=classic_tls_clienthello_www_sferum_ru:@fake/tls_clienthello_www_sferum_ru.bin
--blob=quic_4pda:@fake/quic_initial_4pda_to.bin
--blob=stun2:@fake/stun2.bin
[TCP_HTTP]
--lua-desync=fake:blob=classic_tls_clienthello_www_sferum_ru:repeats=4:tcp_ts=-600000:tcp_ts_up
--lua-desync=multisplit:pos=1:seqovl=480:seqovl_pattern=stun2:tcp_ts_up
[TCP_TLS]
--lua-desync=fake:blob=classic_tls_clienthello_www_sferum_ru:repeats=4:tcp_ts=-600000:tcp_ts_up
--lua-desync=multisplit:pos=1:seqovl=480:seqovl_pattern=stun2:tcp_ts_up
[DISCORD_MEDIA_TLS]
--lua-desync=fake:blob=tls_google:repeats=8:tcp_ts=-600000:tcp_ts_up
--lua-desync=multisplit:pos=1:seqovl=681:seqovl_pattern=tls_google:tcp_ts_up
[GOOGLE_TLS]
--lua-desync=hostfakesplit:host=www.google.com:tcp_ts=-600000:ip_id=zero:tcp_ts_up:repeats=1
[TCP_GENERIC]
--payload=http_req
--lua-desync=fake:blob=classic_tls_clienthello_www_sferum_ru:repeats=4:tcp_ts=-600000:tcp_ts_up
--lua-desync=multisplit:pos=1:seqovl=480:seqovl_pattern=stun2:tcp_ts_up
--payload=tls_client_hello
--lua-desync=fake:blob=classic_tls_clienthello_www_sferum_ru:repeats=4:tcp_ts=-600000:tcp_ts_up
--lua-desync=multisplit:pos=1:seqovl=480:seqovl_pattern=stun2:tcp_ts_up
[QUIC]
--lua-desync=fake:blob=quic_google:repeats=11
[IPSET_TCP_PORTS]
8443
[VOICE_COMPATIBLE]
--filter-udp=19294-19344,50000-50100
--filter-l7=discord,stun,unknown
--out-range=<n4
--payload=discord_ip_discovery
--lua-desync=fake:blob=quic_google:repeats=4
--lua-desync=fake:blob=discord_voice:repeats=4
--payload=stun
--lua-desync=fake:blob=discord_voice:repeats=4
--payload=unknown
--lua-desync=fake:blob=quic_google:repeats=4:payload=unknown
--lua-desync=fake:blob=discord_voice:repeats=4:payload=unknown
[GAME_TCP_RANGE]
<n4
[GAME_TCP_ACTIONS]
--payload=http_req
--lua-desync=fake:blob=classic_tls_clienthello_www_sferum_ru:repeats=8:tcp_ts=-600000:tcp_ts_up
--lua-desync=multisplit:pos=1:seqovl=664:seqovl_pattern=classic_tls_clienthello_www_sferum_ru:tcp_ts_up
--payload=tls_client_hello
--lua-desync=fake:blob=stun2:repeats=8:tcp_ts=-600000:tcp_ts_up
--lua-desync=fake:blob=classic_tls_clienthello_www_sferum_ru:repeats=8:tcp_ts=-600000:tcp_ts_up
--lua-desync=multisplit:pos=1:seqovl=664:seqovl_pattern=classic_tls_clienthello_www_sferum_ru:tcp_ts_up
--payload=unknown
--lua-desync=fake::repeats=8:tcp_ts=-600000:tcp_ts_up:payload=unknown
--lua-desync=multisplit:pos=1:seqovl=664:seqovl_pattern=classic_tls_clienthello_www_sferum_ru:tcp_ts_up
[GAME_UDP_RANGE]
<n4
[GAME_UDP_ACTIONS]
--lua-desync=fake:blob=quic_4pda:repeats=5:payload=all
--lua-desync=fake:blob=game_udp:repeats=5:payload=all
[QUIC_FILTER]
--filter-l7=quic
[IPSET_TCP_EXCLUDE]
--hostlist-exclude-domains=fonts.googleapis.com
