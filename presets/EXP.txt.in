# Classic adaptation of the local Windows reference, EXP.
# EXP retains its upstream name; it is separate from the NEXT development presets.
[PRESET_INIT]
--blob=stun2:@fake/stun2.bin
--blob=quic_4pda:@fake/quic_initial_4pda_to.bin
--blob=unknown_tcp:
[QUIC_FILTER]
--filter-l7=quic
[TCP_HTTP]
--lua-desync=fake:blob=tls_max:tcp_ts=-1000:repeats=4
--lua-desync=multisplit:pos=1:seqovl=480:seqovl_pattern=stun2:tcp_ts_up
[TCP_TLS]
--lua-desync=fake:blob=tls_max:tcp_ts=-1000:repeats=4
--lua-desync=multisplit:pos=1:seqovl=480:seqovl_pattern=stun2:tcp_ts_up
[DISCORD_MEDIA_TLS]
--lua-desync=fake:blob=tls_google:tcp_ts=-1000:repeats=8
--lua-desync=multisplit:pos=1:seqovl=681:seqovl_pattern=tls_google:tcp_ts_up
[GOOGLE_TLS]
--lua-desync=hostfakesplit:host=www.google.com:ip_id=zero:tcp_ts=-1000:tcp_ts_up
[TCP_GENERIC]
--lua-desync=fake:blob=tls_max:tcp_ts=-1000:repeats=4
--lua-desync=multisplit:pos=1:seqovl=480:seqovl_pattern=stun2:tcp_ts_up
[QUIC]
--lua-desync=fake:blob=quic_google:repeats=11
[IPSET_TCP_PORTS]
8443
[IPSET_TCP_EXCLUDE]
--hostlist-exclude=../lists/list-exclude.txt
--hostlist-exclude=../lists/list-exclude-user.txt
--hostlist-exclude-domains=fonts.googleapis.com
[IPSET_UDP_EXCLUDE]
--hostlist-exclude=../lists/list-exclude.txt
--hostlist-exclude=../lists/list-exclude-user.txt
[VOICE_COMPATIBLE]
--filter-udp=19294-19344,50000-50100
--filter-l7=discord,stun,unknown
--out-range=-n4
--payload=discord_ip_discovery,unknown
--lua-desync=fake:blob=quic_google:repeats=4:payload=all
--payload=discord_ip_discovery,stun,unknown
--lua-desync=fake:blob=discord_voice:repeats=4:payload=all
[GAME_TCP_RANGE]
-n4
[GAME_TCP_ACTIONS]
--lua-desync=fake:blob=stun2:tcp_ts=-1000:repeats=8:payload=tls_client_hello
--lua-desync=fake:blob=tls_max:tcp_ts=-1000:repeats=8
--lua-desync=fake:blob=unknown_tcp:tcp_ts=-1000:repeats=8:payload=unknown
--lua-desync=multisplit:pos=1:seqovl=664:seqovl_pattern=tls_max:tcp_ts_up:payload=all
[GAME_UDP_ACTIONS]
--lua-desync=fake:blob=quic_4pda:repeats=5:payload=all
--lua-desync=fake:blob=game_udp:repeats=5:payload=all
