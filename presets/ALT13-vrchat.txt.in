[PRESET_INIT]
--blob=tls_sochi:@fake/tls_clienthello_sochi_park.bin
--blob=stun2:@fake/stun2.bin
--lua-init=@../lua/zapret-next.lua
[TCP_HTTP]
--lua-desync=fake:blob=tls_sochi:tcp_ts=-1000:repeats=5

[TCP_TLS]
--lua-desync=fake:blob=tls_sochi:tcp_ts=-1000:repeats=5
--lua-desync=hostfakesplit:host=api.vrchat.cloud:tcp_ts=-1000:tcp_ts_up

[TCP_GENERIC]
--lua-desync=fake:blob=tls_sochi:tcp_ts=-1000:repeats=5
--lua-desync=fake:blob=stun2:tcp_ts=-1000:repeats=5:payload=tls_client_hello
--lua-desync=next_hostfakesplit:host=mail.ru:tcp_ts=-1000:tcp_ts_up:repeats=5

[GOOGLE_TLS]
--lua-desync=hostfakesplit:host=www.google.com:tcp_ts=-1000:tcp_ts_up


[QUIC]
--lua-desync=fake:blob=quic_google:repeats=11

[DISCORD_MEDIA_TLS]
--lua-desync=fake:blob=tls_google:tcp_ts=-1000:repeats=7
--lua-desync=multisplit:pos=1:seqovl=681:seqovl_pattern=tls_google:tcp_ts_up


[VOICE_COMPATIBLE]
--filter-udp=19294-19344,50000-50100
--filter-l7=discord,stun
--payload=discord_ip_discovery,stun
--lua-desync=fake:blob=discord_voice:repeats=5
