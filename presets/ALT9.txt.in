# Classic reference: local Windows bundle 1.10.3.
[PRESET_INIT]
--lua-init=@../lua/zapret-next.lua
[TCP_HTTP]
--lua-desync=hostfakesplit:host=ozon.ru:tcp_ts=-600000:tcp_md5:tcp_ts_up:repeats=4
[TCP_TLS]
--lua-desync=hostfakesplit:host=ozon.ru:tcp_ts=-600000:tcp_md5:tcp_ts_up:repeats=4
[DISCORD_MEDIA_TLS]
--lua-desync=hostfakesplit:host=www.google.com:tcp_ts=-600000:tcp_ts_up:repeats=4
[GOOGLE_TLS]
--lua-desync=hostfakesplit:host=www.google.com:tcp_ts=-600000:ip_id=zero:tcp_ts_up:repeats=4
[TCP_GENERIC]
--payload=http_req
--lua-desync=hostfakesplit:host=ozon.ru:tcp_ts=-600000:tcp_ts_up:repeats=4
--payload=tls_client_hello
--lua-desync=hostfakesplit:host=ozon.ru:tcp_ts=-600000:tcp_ts_up:repeats=4
[QUIC]
--lua-desync=fake:blob=quic_google:repeats=6
[IPSET_TCP_PORTS]
8443
[VOICE_COMPATIBLE]
--filter-udp=19294-19344,50000-50100
--filter-l7=discord,stun
--payload=discord_ip_discovery
--lua-desync=fake:blob=discord_voice:repeats=6
--payload=stun
--lua-desync=fake:blob=discord_voice:repeats=6
[GAME_TCP_RANGE]
<n3
[GAME_TCP_ACTIONS]
--payload=http_req
--lua-desync=hostfakesplit:host=ozon.ru:tcp_ts=-600000:tcp_ts_up:repeats=4
--payload=tls_client_hello
--lua-desync=hostfakesplit:host=ozon.ru:tcp_ts=-600000:tcp_ts_up:repeats=4
--payload=unknown
--lua-desync=hostfakesplit:host=ozon.ru:tcp_ts=-600000:tcp_ts_up:repeats=4
[GAME_UDP_RANGE]
<n2
[GAME_UDP_ACTIONS]
--lua-desync=fake:blob=game_udp:repeats=12:payload=all
