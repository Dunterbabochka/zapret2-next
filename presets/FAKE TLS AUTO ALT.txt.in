# Classic reference: local Windows bundle 1.10.3; see docs/CLASSIC.md.
[PRESET_INIT]
--lua-init=@../lua/zapret-next.lua
[TCP_HTTP]
--lua-desync=fake:blob=tls_max:repeats=8:tcp_seq=2:tcp_ack=-66000:tcp_ts_up
--lua-desync=fakedsplit:pos=1:pattern=0x00:tcp_seq=2:tcp_ack=-66000:tcp_ts_up:repeats=8
[TCP_TLS]
--lua-desync=fake:blob=fake_default_tls:repeats=8:tcp_seq=2:tcp_ack=-66000:tcp_ts_up:tls_mod=rnd,dupsid,sni=www.google.com
--lua-desync=fakedsplit:pos=1:pattern=0x00:tcp_seq=2:tcp_ack=-66000:tcp_ts_up:repeats=8
[DISCORD_MEDIA_TLS]
--lua-desync=fake:blob=fake_default_tls:repeats=8:tcp_seq=2:tcp_ack=-66000:tcp_ts_up:tls_mod=rnd,dupsid,sni=www.google.com
--lua-desync=fakedsplit:pos=1:pattern=0x00:tcp_seq=2:tcp_ack=-66000:tcp_ts_up:repeats=8
[GOOGLE_TLS]
--lua-desync=fake:blob=fake_default_tls:repeats=8:tcp_seq=2:tcp_ack=-66000:ip_id=zero:tcp_ts_up:tls_mod=rnd,dupsid,sni=www.google.com
--lua-desync=fakedsplit:pos=1:pattern=0x00:tcp_seq=2:tcp_ack=-66000:ip_id=zero:tcp_ts_up:repeats=8
[TCP_GENERIC]
--payload=http_req
--lua-desync=fake:blob=tls_max:repeats=8:tcp_seq=2:tcp_ack=-66000:tcp_ts_up
--lua-desync=fakedsplit:pos=1:pattern=0x00:tcp_seq=2:tcp_ack=-66000:tcp_ts_up:repeats=8
--payload=tls_client_hello
--lua-desync=fake:blob=fake_default_tls:repeats=8:tcp_seq=2:tcp_ack=-66000:tcp_ts_up:tls_mod=rnd,dupsid,sni=www.google.com
--lua-desync=fakedsplit:pos=1:pattern=0x00:tcp_seq=2:tcp_ack=-66000:tcp_ts_up:repeats=8
[QUIC]
--lua-desync=fake:blob=quic_google:repeats=11
[IPSET_TCP_PORTS]
8443
[VOICE_COMPATIBLE]
--filter-udp=19294-19344,50000-50100
--filter-l7=discord,stun
--payload=discord_ip_discovery
--lua-desync=fake:blob=discord_voice:repeats=6
--payload=stun
--lua-desync=fake:blob=discord_voice:repeats=6
[GAME_TCP_RANGE]
<n3
[GAME_TCP_ACTIONS]
--payload=http_req
--lua-desync=fake:blob=tls_max:repeats=8:tcp_seq=2:tcp_ack=-66000:tcp_ts_up
--lua-desync=fakedsplit:pos=1:pattern=0x00:tcp_seq=2:tcp_ack=-66000:tcp_ts_up:repeats=8
--payload=tls_client_hello
--lua-desync=fake:blob=fake_default_tls:repeats=8:tcp_seq=2:tcp_ack=-66000:tcp_ts_up:tls_mod=rnd,dupsid,sni=www.google.com
--lua-desync=fakedsplit:pos=1:pattern=0x00:tcp_seq=2:tcp_ack=-66000:tcp_ts_up:repeats=8
--payload=unknown
--lua-desync=fake:blob=tls_max:repeats=8:tcp_seq=2:tcp_ack=-66000:tcp_ts_up:payload=unknown
--lua-desync=fakedsplit:pos=1:pattern=0x00:tcp_seq=2:tcp_ack=-66000:tcp_ts_up:repeats=8
[GAME_UDP_RANGE]
<n2
[GAME_UDP_ACTIONS]
--lua-desync=fake:blob=game_udp:repeats=10:payload=all
